node_modules/
.next/
out/
next-env.d.ts
tsconfig.tsbuildinfo

.env
.env.local

__pycache__/
*.py[cod]
server/access.log

# AZURE2 writes these into an evaluation while it is being calculated. The
# external-capture integrals under output/ are the exception -- they are slow to
# recompute and are committed on purpose, so they are re-included below.
server/evaluations/*/output/*
!server/evaluations/*/output/intEC.dat
!server/evaluations/*/output/intEC.extrap
server/evaluations/*/checks/
server/evaluations/*/.azure_history

.DS_Store
*.log

# The raw CV and the development notes the published ones were derived from.
# Not deployed (see .dockerignore) and not published: the notes under
# content/notes/ are the public form of this material. Delete this line to track
# it in a private repository.
_source/

# Written by scripts/atlas-export.mjs before every build.
public/atlas/data.json

# Built by browser/assemble.py for the static (GitHub Pages) build
/public/azure2/
/build/

# Results cache written next to each evaluation (server/app/cache.py)
server/evaluations/*/precomputed.json
server/evaluations/*/.precomputed-*

# The derived fine-grid model and its integrals (server/app/fine.py)
server/evaluations/*/fine/
# The split data model and the extrapolation model (server/app/engine.py)
server/evaluations/*/datamodel/
server/evaluations/*/extrap/
server/evaluations/*/extrapolations/
server/evaluations/*/extrapolations-grid/
# What a page draws before its session starts (server/app/initial.py)
server/evaluations/*/initial.json
server/evaluations/*/.initial-*

# Written by scripts/search-index.mjs before every build.
public/search/

# The data explorer (scripts/data/README.md): the per-reaction shards, the
# full-resolution sets and the ENSDF summaries beyond the atlas' nuclei are
# built by `make data` and the Pages workflow. Committed: meta.json,
# exfor/index.json and the atlas nuclei's ENSDF files (tracked, so they stay
# tracked although the pattern below matches them).
/public/data/exfor/r/
/public/data/exfor/sets/
/public/data/ensdf/*.json

# Backups (DEPLOY.md, section 8): they hold the TLS key and access logs.
*.tgz
