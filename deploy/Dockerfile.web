# The website: Next.js, built standalone so the runtime image carries no
# node_modules and no build toolchain.
#
# API_BASE is inlined into the client bundle at build time, which is why it is a
# build argument and not a runtime environment variable. The default, an empty
# string, makes every API call same-origin and relative — the reverse proxy in
# front of this container is what routes /api to the AZURE2 service.

# The WebDAQ demo (webdaq-demo/README.md): the WebDAQ frontend at the commit
# pinned in webdaq-demo/pin.json, with the demo's overlay and simulated
# backend, exported as static files for /webdaq-demo/. git fetches the pinned
# commit (and checks its objects), build.mjs checks every upstream file the
# overlay replaces, npm checks JSROOT's tarball.
FROM node:22-alpine AS webdaq-demo
RUN apk add --no-cache git
WORKDIR /demo
ENV NEXT_TELEMETRY_DISABLED=1
COPY webdaq-demo/package.json webdaq-demo/package-lock.json ./
RUN npm ci --ignore-scripts
COPY webdaq-demo/ ./
RUN DEMO_BASE_PATH=/webdaq-demo node build.mjs --out /demo/export \
 && node scripts/size.mjs /demo/export

FROM node:22-alpine AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

ARG API_BASE=""
ENV API_BASE=${API_BASE}
# Optional absolute origin (https://example.com): hreflang and og:image.
ARG SITE_URL=""
ENV SITE_URL=${SITE_URL}
# Content-Security-Policy: enforce, report-only or off (next.config.mjs).
ARG CSP_MODE=enforce
ENV CSP_MODE=${CSP_MODE}
COPY . .
RUN npm run build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN addgroup -g 1001 -S nodejs && adduser -u 1001 -S nextjs -G nodejs

# `standalone` holds a minimal server plus only the modules Next traced; static
# assets and public/ are not part of it and must be copied alongside.
# Owned by root and only readable by the server's user, which cannot change
# its own code; the one directory it writes, .next/cache, is created for it
# (and is a tmpfs under docker-compose.yml's read-only root filesystem).
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
COPY --from=webdaq-demo /demo/export ./public/webdaq-demo
RUN mkdir -p .next/cache && chown nextjs:nodejs .next/cache

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
