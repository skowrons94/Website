{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext", "webworker"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@webdaq/*": [".work/webdaq/frontend/src/*"],
      "@/demo/*": ["./*"],
      "@/*": [".work/webdaq/frontend/src/*"],
      "axios-real": ["node_modules/axios"]
    }
  },
  "include": ["shim/**/*.ts", "shim/**/*.tsx", "shell/**/*.ts", "shell/**/*.tsx", "tour/**/*.ts", "sim/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", ".work", "overlay"]
}
