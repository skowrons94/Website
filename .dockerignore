# Build products and local state. The server/ tree and content/ must NOT be
# excluded: both images copy from them.
node_modules
.next
.git
.env
_source
npm-debug.log*
.DS_Store
**/.DS_Store
**/__pycache__
server/access.log

# The GitHub Pages build's engine and its inputs (browser/README.md): large,
# and nothing the server images use.
build
out
public/azure2

# The WebDAQ demo is built inside the image (deploy/Dockerfile.web) from
# webdaq-demo/'s sources; not its local install, fetches or build output.
webdaq-demo/node_modules
webdaq-demo/.work
webdaq-demo/out
public/webdaq-demo
