{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "dx-exfor-shard",
 "type": "object",
 "required": [
  "schema",
  "schema_version",
  "reaction",
  "entries",
  "datasets"
 ],
 "properties": {
  "schema": {
   "const": "dx-exfor-shard"
  },
  "schema_version": {
   "const": 1
  },
  "reaction": {
   "type": "object",
   "required": [
    "key",
    "slug",
    "target",
    "projectile",
    "process",
    "atlas"
   ]
  },
  "entries": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "authors",
     "title",
     "refs",
     "links"
    ],
    "properties": {
     "links": {
      "type": "object",
      "required": [
       "exfor",
       "master"
      ]
     }
    }
   }
  },
  "pages": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "datasets": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "meta"
    ],
    "properties": {
     "meta": {
      "type": "object",
      "required": [
       "id",
       "entry",
       "subentry",
       "pointer",
       "code",
       "sf",
       "complex",
       "reaction",
       "target",
       "projectile",
       "process",
       "quantity",
       "quantity_class",
       "E_frame",
       "ang_frame",
       "value_unit",
       "emin_cm",
       "emax_cm",
       "npts",
       "nexcluded",
       "final_levels",
       "err_components",
       "d_tot_source",
       "err_columns",
       "flags",
       "status",
       "history",
       "subentry_date",
       "slices"
      ],
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^[0-9A-Z][0-9]{4}\\.[0-9]{3}(\\.[0-9A-Z])?$"
       },
       "entry": {
        "type": "string",
        "pattern": "^[0-9A-Z][0-9]{4}$"
       },
       "sf": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "array",
         "minItems": 9,
         "maxItems": 9,
         "items": {
          "type": "string"
         }
        }
       },
       "quantity_class": {
        "enum": [
         "sigma",
         "S",
         "dsigma",
         "legendre",
         "ddx",
         "pol",
         "yield",
         "strength",
         "width",
         "macs",
         "sacs",
         "rate",
         "ratio",
         "integral",
         "other"
        ]
       },
       "E_frame": {
        "enum": [
         "lab",
         "cm",
         "lab-res",
         "cm-res",
         null
        ]
       },
       "ang_frame": {
        "enum": [
         "lab",
         "cm",
         null
        ]
       },
       "emin_cm": {
        "type": [
         "number",
         "null"
        ]
       },
       "emax_cm": {
        "type": [
         "number",
         "null"
        ]
       },
       "npts": {
        "type": "integer",
        "minimum": 0
       },
       "final_levels": {
        "type": "array",
        "items": {
         "type": [
          "number",
          "null"
         ]
        }
       },
       "err_components": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "name",
          "kind",
          "where",
          "unit",
          "relative"
         ],
         "properties": {
          "kind": {
           "enum": [
            "stat",
            "sys",
            "total",
            "digitising"
           ]
          },
          "where": {
           "enum": [
            "point",
            "common"
           ]
          }
         }
        }
       },
       "err_columns": {
        "type": "object",
        "additionalProperties": {
         "enum": [
          "err",
          "d_tot",
          "d_stat",
          "d_sys"
         ]
        }
       },
       "flags": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "slices": {
        "type": "array",
        "items": {
         "enum": [
          "A",
          "B",
          "M",
          "N"
         ]
        },
        "minItems": 1
       }
      }
     },
     "points": {
      "type": "object",
      "required": [
       "E_lab",
       "E_cm",
       "value"
      ],
      "properties": {
       "E_lab": {
        "type": "array",
        "items": {
         "type": [
          "number",
          "null"
         ]
        }
       },
       "E_cm": {
        "type": "array",
        "items": {
         "type": [
          "number",
          "null"
         ]
        }
       },
       "value": {
        "type": "array",
        "items": {
         "type": [
          "number",
          "null"
         ]
        }
       },
       "d_stat": {
        "type": "array",
        "items": {
         "type": [
          "number",
          "null"
         ]
        }
       },
       "d_sys": {
        "type": "array",
        "items": {
         "type": [
          "number",
          "null"
         ]
        }
       },
       "d_tot": {
        "type": "array",
        "items": {
         "type": [
          "number",
          "null"
         ]
        }
       },
       "dE": {
        "type": "array",
        "items": {
         "type": [
          "number",
          "null"
         ]
        }
       },
       "kT": {
        "type": "array",
        "items": {
         "type": [
          "number",
          "null"
         ]
        }
       },
       "ang": {
        "type": "array",
        "items": {
         "type": [
          "number",
          "null"
         ]
        }
       },
       "E_level": {
        "type": "array",
        "items": {
         "type": [
          "number",
          "null"
         ]
        }
       },
       "level_number": {
        "type": "array",
        "items": {
         "type": [
          "number",
          "null"
         ]
        }
       },
       "flag": {
        "type": "array",
        "items": {
         "type": [
          "number",
          "null"
         ]
        }
       },
       "limit": {
        "type": "array",
        "items": {
         "enum": [
          null,
          "<",
          ">",
          "range"
         ]
        }
       },
       "err": {
        "type": "object",
        "additionalProperties": {
         "type": "array",
         "items": {
          "type": [
           "number",
           "null"
          ]
         }
        }
       }
      }
     },
     "excluded": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "reason"
       ]
      }
     },
     "page": {
      "type": "string"
     },
     "decimated": {
      "type": "object",
      "required": [
       "total",
       "kept",
       "full"
      ]
     }
    }
   }
  }
 }
}