# The website: Next.js, built standalone so the runtime image carries no
# node_modules and no build toolchain.
#
# API_BASE is inlined into the client bundle at build time, which is why it is a
# build argument and not a runtime environment variable. The default, an empty
# string, makes every API call same-origin and relative — the reverse proxy in
# front of this container is what routes /api to the AZURE2 service.

FROM node:22-alpine AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

ARG API_BASE=""
ENV API_BASE=${API_BASE}
# Optional absolute origin (https://example.com): hreflang and og:image.
ARG SITE_URL=""
ENV SITE_URL=${SITE_URL}
COPY . .
RUN npm run build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN addgroup -g 1001 -S nodejs && adduser -u 1001 -S nextjs -G nodejs

# `standalone` holds a minimal server plus only the modules Next traced; static
# assets and public/ are not part of it and must be copied alongside.
COPY --from=build --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=build --chown=nextjs:nodejs /app/public ./public

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
