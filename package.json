{
  "name": "skowronski-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/atlas-export.mjs && node scripts/data-summary.mjs && node scripts/search-index.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/evaluations-check.mjs --quiet && node scripts/atlas-check.mjs && node scripts/atlas-export.mjs && node scripts/data-summary.mjs && node scripts/search-index.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:atlas": "node scripts/atlas-check.mjs",
    "check:evaluations": "node scripts/evaluations-check.mjs",
    "eval:new": "python3 scripts/add-evaluation.py",
    "test:search": "node scripts/search-index.mjs && node scripts/search-test.mjs",
    "test:rates": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/rates/test.mjs",
    "rates:baseline": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/rates/baseline.mjs",
    "test:data": "python3 -m pytest -q scripts/data/tests",
    "data:summary": "node scripts/data-summary.mjs",
    "test:data-ui": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/data-ui/test.mjs",
    "data": "make data"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-label": "latest",
    "@radix-ui/react-select": "latest",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "autoprefixer": "^10.4.20",
    "axios": "^1.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "katex": "^0.16.22",
    "lucide-react": "^0.454.0",
    "next": "^15.5.22",
    "next-themes": "^0.4.4",
    "react": "^19",
    "react-dom": "^19",
    "react-katex": "^3.1.0",
    "recharts": "2.15.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
