# The AZURE2 evaluation API: the R-matrix engine, pyazr, and the Flask server
# that owns one AZURE2 worker process per open session.
#
# Since pyazr 2.8 the engine is a pybind11 extension module (`_azure2`) rather
# than a subprocess spoken to over a socket, so the two halves must come from
# one build: CMake compiles the module into the repository's `pyazr/` directory
# and `pip install .` then packages the two together.  Installing pyazr from
# anywhere else would pair Python against an engine it was not built with.
#
# ROOT is not a dependency.  Minuit2, coul and erya are vendored in the AZURE2
# tree, so the only outside libraries are GSL and an OpenMP runtime -- which is
# what keeps this image minutes rather than an hour to build.

# --- build ------------------------------------------------------------------

FROM ubuntu:22.04 AS build

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git pkg-config ca-certificates \
        libgsl-dev python3 python3-dev python3-pip python3-venv \
 && rm -rf /var/lib/apt/lists/*

# Everything Python lands in one prefix, so the runtime stage is a single COPY
# and carries no build toolchain.
RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
RUN pip install --no-cache-dir --upgrade pip setuptools wheel pybind11

# Pinned to a commit, not a branch: a rebuild of the site must not silently
# change the physics the published evaluations are calculated with.  To take a
# newer AZURE2, bump this and re-run the evaluations before deploying.
ARG AZURE2_REF=7e533b729c74fcbc61de96f04769f2dc60439795
RUN git clone https://github.com/rdeboer1/AZURE2.git /src/AZURE2 \
 && git -C /src/AZURE2 checkout --detach ${AZURE2_REF}

# BUILD_GUI=OFF drops Qt entirely; USE_API=ON is what produces the _azure2
# module, which CMake writes into /src/AZURE2/pyazr/ for the install below.
# BUILD_JOBS caps the compile: Minuit2 and the engine together will exhaust a
# 2 GB VPS at one job per core.  Leave it empty for all cores, set it to 1 or 2
# on a small box (see the README).
ARG BUILD_JOBS=
RUN cmake -S /src/AZURE2 -B /src/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DUSE_API=ON -DBUILD_GUI=OFF -DUSE_QWT=OFF \
        -Dpybind11_DIR="$(python3 -m pybind11 --cmakedir)" \
 && cmake --build /src/build --target _azure2 -j "${BUILD_JOBS:-$(nproc)}"

# Fail loudly here rather than at the first request: without the module, pyazr
# installs happily and every session dies on import.
RUN test -n "$(ls /src/AZURE2/pyazr/_azure2*.so 2>/dev/null)" \
    || (echo "the _azure2 module was not built; check the pybind11 discovery above" && false)

RUN pip install --no-cache-dir /src/AZURE2 \
 && python -c "import pyazr, pyazr._azure2; print('pyazr', pyazr.__version__)"

COPY server/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# --- runtime ----------------------------------------------------------------

FROM ubuntu:22.04 AS runtime

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# libgsl27 and libgomp1 are what the engine links; python3 must be the same
# minor version as the venv was built against, which is what the base image
# pinned to 22.04 guarantees.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 libgsl27 libgomp1 curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

# A session's worker writes AZURE2's output files into the evaluation's own
# directory, so the server must not run as root against a bind-mounted tree it
# would then leave root-owned files in.
RUN useradd --create-home --uid 1001 azure2

WORKDIR /app
COPY --chown=azure2:azure2 server/ /app/

ENV AZURE2_HOST=0.0.0.0 \
    AZURE2_PORT=5001 \
    AZURE2_EVALUATIONS_DIR=/app/evaluations \
    PYTHONUNBUFFERED=1

USER azure2
EXPOSE 5001

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:5001/api/health || exit 1

CMD ["python3", "main.py"]
