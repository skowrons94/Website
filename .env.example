# Copy to .env before `docker compose up`. The first two are required; the rest
# have working defaults and are the knobs to turn on a small VPS.

# The domain pointed at this VPS. Caddy requests a certificate for exactly this.
SITE_DOMAIN=example.com

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

# How many AZURE2 worker processes may run at once, and how long an idle session
# lives before it is reaped. Each open evaluation is one process, so this is what
# bounds memory: budget a few hundred MB per slot for the larger models.
AZURE2_MAX_SESSIONS=8
AZURE2_SESSION_TTL=1800

# OpenMP threads per worker. Every session is its own process, so the total load
# is MAX_SESSIONS x OMP_THREADS; one thread apiece keeps a small VPS responsive.
AZURE2_OMP_THREADS=1

# Waitress request threads. Unrelated to the above: these serve HTTP, they do
# not run AZURE2.
AZURE2_THREADS=10
