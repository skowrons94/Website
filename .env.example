# Copy to .env before `docker compose up`. SITE_DOMAIN and ACME_EMAIL are
# required, SITE_URL (https:// + SITE_DOMAIN) is strongly recommended; the rest
# have working defaults and are the knobs to turn on a small VPS.

# The domain pointed at this VPS. Caddy requests a certificate for exactly this.
SITE_DOMAIN=example.com

# Strongly recommended: the site's own address, https:// and the domain above,
# no trailing slash. It is baked in at build time. With it, shared links get a
# preview image (Open Graph needs an absolute URL, so without it og:image is
# left out), the language alternates become absolute, and the atlas' citation
# box and the printed CV show the public address. Left empty, the site works,
# just without those (deliberately empty here: a wrong address would be worse
# than none). Rebuild (make deploy) after changing it.
SITE_URL=

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

# How many AZURE2 worker processes may run at once, and how long an idle session
# lives before it is reaped. Each open evaluation is one process, so this is what
# bounds memory: budget a few hundred MB per slot for the larger models.
AZURE2_MAX_SESSIONS=8
AZURE2_SESSION_TTL=1800

# OpenMP threads per worker. Every session is its own process, so the total load
# is MAX_SESSIONS x OMP_THREADS; one thread apiece keeps a small VPS responsive.
AZURE2_OMP_THREADS=1

# Waitress request threads. Unrelated to the above: these serve HTTP, they do
# not run AZURE2.
AZURE2_THREADS=10

# Who the AZURE2 container runs as. The evaluations are bind-mounted from
# ./server/evaluations, and a worker caches the external-capture integrals in
# them, so this must be able to write there. Set both to the output of `id -u`
# and `id -g` if that directory belongs to your user rather than to uid 1001.
AZURE2_UID=1001
AZURE2_GID=1001
