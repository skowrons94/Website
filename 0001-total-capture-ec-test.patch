index 0000000..5b1e2ba
--- /dev/null
+++ b/tests/total_capture_ec/README.md
@@ -0,0 +1,37 @@
+# total_capture_ec — total capture is the sum of its final states, with external capture
+
+A total-capture segment (`isDiff 3` in `<segmentsData>`, `isDiff 4` in
+`<segmentsTest>`, exit key `-1`) is an incoherent sum over the capture pairs,
+so for one model it must equal the sum of the single-pair capture segments at
+the same energies, and must not depend on which other segments the project
+holds. With external capture on, the total's component segments
+(`EData::CreateComponentSegment`) get their EC amplitudes in a separate pass
+(`EData::InitializeComponentSegments`) that appends to, or reads back from,
+the same `intEC.dat` / `intEC.extrap` as the data segments.
+
+Before 886cdf7 the amplitude count left the component part out, so every
+reuse of a file was rejected and the data-segment part rewritten, and the
+component pass, which re-read the `USE_PREVIOUS_INTEGRALS` flag, then read the
+rewritten file from its start as if it were the component part. pyazr asks for
+reuse whenever `output/intEC.dat` exists, so from the second run in a project
+directory on, 13C(p,g)14N gave a total 15-25 % low at 46 keV, different with
+and without the single-pair segments beside it.
+
+The model is 13C+p with three capture pairs (gamma to 0, 2.313 and 3.948 MeV
+in 14N, with ANCs on the three final states), cut down from the 14N
+evaluation: one 1- resonance (8.06 MeV) and the three bound states. Segments
+1-3 are the single-pair segments, segment 4 the total; every energy appears
+twice in the data file, so the single-pair segments also carry mapped points.
+
+`check.sh`, in data mode (1) and extrapolation mode (3), checks that
+
+- the total equals the sum of the single-pair segments point by point;
+- the total alone, and the total listed before the single-pair segments, give
+  the same total (and so does `AZURE_NO_POINT_MAPPING=1`, in data mode);
+- a file built for the full model is rejected for the total alone, and the
+  recomputed total is unchanged;
+- the model's own file is reused, for the full model and for the total alone,
+  and gives the same total to the file's six significant digits.
+
+The directory is also an ordinary `run_tests.sh` project:
+`expected/chiSquared.out` locks the chi-squared of the four segments.
diff --git a/tests/total_capture_ec/check.sh b/tests/total_capture_ec/check.sh
new file mode 100755
index 0000000..5f3f809
--- /dev/null
+++ b/tests/total_capture_ec/check.sh
@@ -0,0 +1,150 @@
+#!/usr/bin/env bash
+#
+# A total-capture segment equals the sum of its single-pair capture segments,
+# with external (direct) capture on, and does not depend on which other
+# segments the model holds.
+#
+# A total over final states is an incoherent sum, so for the same model and
+# the same energies sigma_total = sum_f sigma(p,gamma_f) exactly.  With
+# external capture the total's components (EData::CreateComponentSegment) get
+# their EC amplitudes from their own pass, InitializeComponentSegments, which
+# appends to -- or reads back from -- the same intEC file as the data
+# segments.  Before 886cdf7 a reused file that was rejected (wrong count) was
+# rewritten for the data segments only, and the component pass then read it
+# from the start as if it were the component part: on 13C(p,g)14N the total
+# came out 15-25 % low, and different depending on which single-pair segments
+# sat beside it.
+#
+# Model: 13C+p with three capture pairs (gamma to 0, 2.313 and 3.948 MeV in
+# 14N; ANCs on the three final states, so external capture feeds all three).
+# Segments 1-3 are the single-pair segments, segment 4 the total (isDiff 3);
+# the extrapolation grid has the same four (isDiff 4 for the total).  Every
+# energy in the data file appears twice, so the single-pair segments also
+# carry mapped points (EData::MapData).
+#
+#   ./tests/total_capture_ec/check.sh path/to/AZURE2
+#
+# Exit status 0 when every check passes.
+
+set -uo pipefail
+export LC_ALL=C
+
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+AZURE2_BIN="${1:?usage: check.sh path/to/AZURE2}"
+AZURE2_BIN="$(cd "$(dirname "$AZURE2_BIN")" && pwd)/$(basename "$AZURE2_BIN")"
+export OMP_NUM_THREADS="${OMP_NUM_THREADS:-2}"
+
+WORK="$(mktemp -d "${TMPDIR:-/tmp}/total_capture_ec.XXXXXX")"
+trap 'rm -rf "$WORK"' EXIT
+
+failures=0
+ok() { echo "  ok    $1"; }
+bad() { echo "  FAIL  $1"; failures=$((failures + 1)); }
+
+# make_variant NAME ACTIVE: a copy of the model whose data and test segments
+# are switched on according to ACTIVE, a string of four 0/1 flags in segment
+# order; "reversed" puts the total first instead.
+make_variant() {
+  local dir="$WORK/$1"
+  mkdir -p "$dir/output" "$dir/checks"
+  cp -R "$HERE/data" "$dir/data"
+  awk -v active="$2" '
+    /<segmentsData>|<segmentsTest>/ { inseg = 1; n = 0; m = 0; print; next }
+    /<\/segmentsData>|<\/segmentsTest>/ { inseg = 0
+      if (active == "reversed") { print held[m]; for (i = 1; i < m; i++) print held[i] }
+    }
+    inseg && NF {
+      n++
+      if (active == "reversed") { held[++m] = $0; next }
+      $1 = substr(active, n, 1)
+    }
+    { print }' "$HERE/total_capture_ec.azr" > "$dir/model.azr"
+}
+
+# run NAME MODE [EC_FILE]: MODE 1 (data) or 3 (extrapolation), optionally
+# reusing a saved EC file, passed relative to the run directory.
+run() {
+  local dir="$WORK/$1" mode="$2" ec="${3:-}" input
+  if [ "$mode" = 1 ]; then input="1\n\n$ec\n7\n"; else input="3\nn\n\n$ec\n7\n"; fi
+  (cd "$dir" && printf "$input" | "$AZURE2_BIN" --no-gui --no-readline model.azr > run.log 2>&1)
+}
+
+# Column 4 of an output file is the calculated cross section (blank lines,
+# which separate angles, are skipped).
+col() { awk 'NF { printf "%.10e\n", $4 }' "$1"; }
+
+# sum_matches NAME EXT: the total equals the sum of the single-pair files,
+# point by point, to 1e-6 (the files print 11 significant digits).
+sum_matches() {
+  local o="$WORK/$1/output"
+  paste <(col "$o/AZUREOut_aa=1_R=2.$2") <(col "$o/AZUREOut_aa=1_R=3.$2") \
+        <(col "$o/AZUREOut_aa=1_R=4.$2") <(col "$o/AZUREOut_aa=1_TOTAL_CAPTURE.$2") |
+    awk 'NF != 4 { bad = 1; exit }
+         { s = $1 + $2 + $3; d = ($4 - s) / s; if (d < 0) d = -d; if (d > worst) worst = d; n++ }
+         END { if (bad || n == 0) { print "no rows"; exit 1 }
+               printf "%d points, worst relative difference %.2g\n", n, worst; exit !(worst < 1e-6) }'
+}
+
+# same_total A B EXT TOL: the total-capture files of two runs agree to TOL.
+same_total() {
+  paste <(col "$WORK/$1/output/AZUREOut_aa=1_TOTAL_CAPTURE.$3") \
+        <(col "$WORK/$2/output/AZUREOut_aa=1_TOTAL_CAPTURE.$3") |
+    awk -v tol="$4" 'NF != 2 { bad = 1; exit }
+         { d = ($1 - $2) / $2; if (d < 0) d = -d; if (d > worst) worst = d; n++ }
+         END { if (bad || n == 0) { print "no rows"; exit 1 }
+               printf "worst relative difference %.2g\n", worst; exit !(worst <= tol) }'
+}
+
+# Reading a file back is not bit-exact: intEC stores each amplitude to six
+# significant digits.  A recomputed file is compared to 1e-9, a reused one to
+# 1e-4.
+FRESH=1e-9
+REUSED=1e-4
+
+make_variant all 1111
+make_variant totonly 0001
+make_variant reversed reversed
+make_variant nomap 1111
+
+for mode in 1 3; do
+  if [ "$mode" = 1 ]; then ext=out; ecf=intEC.dat; label="data mode"; else ext=extrap; ecf=intEC.extrap; label="extrapolation mode"; fi
+  echo "$label"
+  rm -rf "$WORK"/*/output/* "$WORK"/intEC.*
+
+  run all "$mode"
+  r="$(sum_matches all $ext)" && ok "fresh: total = sum of the single-pair segments ($r)" || bad "fresh: total != sum ($r)"
+
+  run totonly "$mode"
+  r="$(same_total totonly all $ext $FRESH)" && ok "fresh: the total alone gives the same total ($r)" || bad "fresh: the total alone differs ($r)"
+
+  run reversed "$mode"
+  r="$(same_total reversed all $ext $FRESH)" && ok "fresh: listing the total first gives the same total ($r)" || bad "fresh: total first differs ($r)"
+
+  if [ "$mode" = 1 ]; then
+    (cd "$WORK/nomap" && printf "1\n\n\n7\n" | AZURE_NO_POINT_MAPPING=1 "$AZURE2_BIN" --no-gui --no-readline model.azr > run.log 2>&1)
+    r="$(same_total nomap all $ext $FRESH)" && ok "fresh: point mapping off gives the same total ($r)" || bad "point mapping changes the total ($r)"
+  fi
+
+  cp "$WORK/all/output/$ecf" "$WORK/all/output/$ecf.sig" "$WORK/"
+
+  # The file written beside them is the right size only for the full model:
+  # here it is rejected and the integrals recomputed.  This is the case that
+  # used to read the data-segment part back as the component part.
+  run totonly "$mode" "../$ecf"
+  grep -q "WARNING: .*$ecf" "$WORK/totonly/run.log" && ok "a file built for other segments is rejected" || bad "the full model's file was not rejected for the total alone"
+  r="$(same_total totonly all $ext $FRESH)" && ok "and the total is unchanged ($r)" || bad "rejected-file run: total differs ($r)"
+
+  # A file on its own model is reused, data and component parts alike.
+  run all "$mode" "../$ecf"
+  grep -q "WARNING: .*$ecf\|Could not open external capture file" "$WORK/all/run.log" && bad "the model's own file was not reused" || ok "the model's own file is reused"
+  r="$(sum_matches all $ext)" && ok "reused: total = sum of the single-pair segments ($r)" || bad "reused: total != sum ($r)"
+  r="$(same_total all totonly $ext $REUSED)" && ok "reused: total equals the fresh one to the file's precision ($r)" || bad "reused: total differs from the fresh one ($r)"
+
+  # And the total alone, reusing a file written for the total alone.
+  cp "$WORK/totonly/output/$ecf" "$WORK/totonly/output/$ecf.sig" "$WORK/"
+  run totonly "$mode" "../$ecf"
+  grep -q "WARNING: .*$ecf\|Could not open external capture file" "$WORK/totonly/run.log" && bad "the total-only file was not reused" || ok "the total-only model's own file is reused"
+  r="$(same_total totonly reversed $ext $REUSED)" && ok "reused: the total alone gives the same total ($r)" || bad "reused: the total alone differs ($r)"
+done
+
+[ "$failures" -eq 0 ] && echo "  PASS" || { echo "  FAIL ($failures)"; exit 1; }
