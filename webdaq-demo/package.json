{
  "name": "webdaq-demo",
  "version": "0.1.0",
  "private": true,
  "description": "WebDAQ frontend at a pinned commit, built as a static site with a simulated backend in a Web Worker.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "size": "node scripts/size.mjs",
    "test": "vitest run -c tests/contract/vitest.config.ts && vitest run -c tests/files/vitest.config.ts && vitest run -c tests/shell/vitest.config.ts && vitest run -c tests/physics/vitest.config.ts",
    "test:contract": "vitest run -c tests/contract/vitest.config.ts",
    "test:physics": "vitest run -c tests/physics/vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "surface": "WRITE_SURFACE=1 vitest run -c tests/contract/vitest.config.ts contract",
    "test:files": "vitest run -c tests/files/vitest.config.ts",
    "test:shell": "vitest run -c tests/shell/vitest.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
